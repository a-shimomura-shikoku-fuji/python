  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #f8fafc; }
QFrame#Sidebar { background-color: #0f172a; }

/* 左側ナビゲーションボタン */
QFrame#Sidebar QPushButton {
    color: #cbd5e1 !important; 
    background-color: transparent !important; 
    text-align: left;
    padding-left: 15px; 
    border: none !important; 
    border-radius: 6px;
}
QFrame#Sidebar QPushButton:hover { color: #ffffff !important; background-color: #1e293b !important; }
QFrame#Sidebar QPushButton:checked { color: #ffffff !important; background-color: #2563eb !important; font-weight: bold; }

/* 右側業務機能ボタン（営業技術部・総務部共通の洗練されたネイビーデザイン） */
QStackedWidget QPushButton {
    background-color: #1e3a8a;
    color: #ffffff !important;
    border-radius: 6px;
    font-size: 11pt;
    font-weight: bold;
    border: 1px solid #172554;
}
QStackedWidget QPushButton:hover, QStackedWidget QPushButton:focus {
    background-color: #2563eb;
    color: #ffffff !important;
    border: 1px solid #60a5fa;
}
QStackedWidget QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8 !important;
    border: 1px solid #e2e8f0;
}</string>
