  <property name="styleSheet">
   <string notr="true">/*  ウインドウのスタイル */
QMainWindow {
    background-color: #e2e8f0;
}

/* ラベル：タイトルのスタイル */
QLabel[objectName^=&quot;title_&quot;]  {
    color: #1e3a8a;
}

/* ラベル：入力項目のスタイル */
QLabel[objectName^=&quot;label_&quot;]  {
    background-color: #64748b;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #64748b;
    border-radius: 4px;
}

/* 入力項目：日付（QDateEdit）のスタイル */
QDateEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 1px 4px;
}
QDateEdit:focus {
    background-color: #f8fafc;
    border: 1px solid #3b82f6;
}

/*フレームのスタイル */
QFrame#frame_btn {
    background-color: #cbd5e1; 
    border: 1px solid #94a3b8;
    border-radius: 6px;
}

/* ボタン：通常のスタイル */
QPushButton[objectName^=&quot;btn_exe_&quot;] {
    background-color: #1e3a8a;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #172554;
    border-radius: 6px;
}
QPushButton[objectName^=&quot;btn_exe_&quot;]:hover {
    background-color: #2563eb;
    border-color: #60a5fa;
}
QPushButton[objectName^=&quot;btn_exe_&quot;]:pressed {
    background-color: #1d4ed8;
    border-color: #3b82f6;
    color: #eff6ff;
}

/* ボタン：戻る、クリアのスタイル */
QPushButton#btn_back, 
QPushButton#btn_clear { 
    background-color: #e2e8f0;
    color: #475569;
    font-weight: bold; 
    border: 1px solid #94a3b8;
    border-radius: 6px;
}
QPushButton#btn_back:hover, 
QPushButton#btn_clear:hover { 
    background-color: #cbd5e1;
    color: #334155;            
    border: 1px solid #334155;
}
QPushButton#btn_back:pressed, 
QPushButton#btn_clear:pressed { 
    background-color: #94a3b8;
    color: #1e293b; 
    border: 1px solid #1e293b;
}

/* ボタン：ダミーのスタイル */
QPushButton[objectName^=&quot;btn_dummy_&quot;] {
    background-color: #f1f5f9; 
    border: 1px solid #cbd5e1;
    border-radius: 6px;
}</string>
