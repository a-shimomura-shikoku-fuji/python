  <property name="styleSheet">
   <string notr="true">/*  ウインドウのスタイル */
QMainWindow {
    background-color: #f8fafc;
}

/* タイトルラベルのスタイル */
QLabel[objectName^=&quot;title_&quot;]  {
    color: #1e3a8a;
}

/* 入力項目ラベルのスタイル */
QLabel[objectName^=&quot;label_&quot;]  {
    background-color: #64748b;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #64748b;
    border-radius: 4px;
}

/* 入力項目表示データのスタイル */
QLabel[objectName^=&quot;data_&quot;]  {
    background-color: #f1f5f9;
    color: #334155;
    font-weight: bold;
    border: 1px solid #475569;
    border-radius: 4px;
    padding: 1px;
}

/* 入力項目テキスト（QTextEdit）のスタイル */
QTextEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 1px;
}

/* 入力項目日付（QDateEdit）のスタイル */
QDateEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 1px 4px;
}
QDateEdit:focus {
    background-color: #f8fafc;
    border: 1px solid #3b82f6;
}

/* 入力項目コンボボックス（QComboBox）のスタイル */


/* 表示項目ラベルのスタイル */
QLabel[objectName^=&quot;label_disp_&quot;]  {
    background-color: #94a3b8;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #475569;
    border-radius: 4px;
}

/* フレームのスタイル */
QFrame#frame_btn {
    background-color: #f1f5f9; 
    border: 1px solid #94a3b8;
    border-radius: 6px;
}
QFrame#frame_search_results {
    border: 1px solid #94a3b8;
    border-radius: 6px;
}

/* テーブルのスタイル */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #475569;
    border: 1px solid #475569;
    padding: 1px;
    border-radius: 4px;
}

/* 通常ボタンのスタイル */
QPushButton[objectName^=&quot;btn_exe_&quot;] {
    background-color: #1e3a8a;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #172554;
    border-radius: 6px;
}
QPushButton[objectName^=&quot;btn_exe_&quot;]:hover {
    background-color: #2563eb;
    border-color: #60a5fa;
}
QPushButton[objectName^=&quot;btn_exe_&quot;]:pressed {
    background-color: #1d4ed8;
    border-color: #3b82f6;
    color: #eff6ff;
}

/* 戻るボタン、クリアボタンのスタイル */
QPushButton#btn_back, 
QPushButton#btn_clear { 
    background-color: #e2e8f0;
    color: #475569;
    font-weight: bold; 
    border: 1px solid #475569;
    border-radius: 6px;
}
QPushButton#btn_back:hover, 
QPushButton#btn_clear:hover { 
    background-color: #cbd5e1;
    color: #334155;            
    border: 1px solid #334155;
}
QPushButton#btn_back:pressed, 
QPushButton#btn_clear:pressed { 
    background-color: #94a3b8;
    color: #1e293b; 
    border: 1px solid #1e293b;
}

/* ダミーボタンのスタイル */
QPushButton[objectName^=&quot;btn_dummy_&quot;] {
    background-color: #f1f5f9; 
    border: 1px solid #cbd5e1;
    border-radius: 6px;
}

QComboBox, QTextEdit, QListWidget {
    background-color: #ffffff;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 1px;
    color: #0f172a;
}
QComboBox:focus, QTextEdit:focus, QListWidget:focus {
    border: 1px solid #3b82f6;
    background-color: #f8fafc;
}
QTableWidget {
    background-color: #ffffff;
    gridline-color: #475569;
    border: 1px solid #475569;
    padding: 1px;
    border-radius: 4px;
}
</string>
