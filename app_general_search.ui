  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #f8fafc; }
QLabel[objectName^=&quot;label_&quot;] {
    background-color: #64748b;
    color: #ffffff !important;
    font-weight: bold;
    border: 1px solid #64748b;
    border-radius: 4px;
}
QLabel#label_title_cond, QLabel#label_title_result {
    background-color: transparent;
    color: #1e3a8a !important;
    font-weight: bold;
    border: none;
}
QComboBox, QTextEdit, QListWidget {
    background-color: #ffffff;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 1px;
    color: #0f172a;
}
QComboBox:focus, QTextEdit:focus, QListWidget:focus {
    border: 1px solid #3b82f6;
    background-color: #f8fafc;
}
QTableWidget {
    background-color: #ffffff;
    gridline-color: #475569;
    border: 1px solid #475569;
    padding: 1px;
    border-radius: 4px;
}
</string>
