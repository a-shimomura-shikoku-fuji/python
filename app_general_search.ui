      <property name="styleSheet">
       <string notr="true">QTableWidget {
    background-color: #ffffff;
    gridline-color: #94a3b8;
    border: 1px solid #94a3b8;
    padding: 1px;
    border-radius: 4px;
}
/* 1. 列ヘッダー（上部）のデザイン設定 */
QHeaderView::section:horizontal {
    background-color: #94a3b8; /* 背景色 */
    color: #ffffff;            /* 文字色 */
    font-weight: bold;         /* 太字 */
    border: 1px solid #172554; /* 枠線 */
    text-align: left;          /* 左寄せ */
　/* 💡【ここを追記】上下に12ピクセルの余白を作ることで、ヘッダーを高くします */
    padding-top: 0px;
    padding-bottom: 0px;
}

/* 2. 行ヘッダー（左側）のデザイン設定 */
QHeaderView::section:vertical {
    background-color: #94a3b8; /* 背景色 */
    color: #ffffff;            /* 文字色 */
    font-weight: bold;         /* 太字 */
    border: 1px solid #172554; /* 枠線 */
    
    /* 💡【Qt6.11.1の絶対ルール】
       CSSの text-align ではなく、Qt内部の配置プロパティを直接右寄せ(AlignRight)に上書きします。
       大文字・小文字を厳密に区別するため、このままコピーしてください。 */
    qproperty-defaultAlignment: 'AlignRight | AlignVCenter';
    
    padding-right: 6px;        /* 数字が枠線にベタッとくっつかないための隙間 */
}
</string>
      </property>
      <property name="editTriggers">
       <set>QAbstractItemView::EditTrigger::NoEditTriggers</set>
