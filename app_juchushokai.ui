  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: #f8fafc; }

/* 項目見出し（ラベル）のスタイル */
QLabel[objectName^=&quot;label_1&quot;] {
    background-color: #94a3b8;
    color: #ffffff !important;
    font-weight: bold;
    border: 1px solid #475569;
    border-radius: 4px;
}
QLabel#label_2, QLabel#label_4, QLabel#label_6, QLabel#label_7 {
    background-color: #64748b;
    color: #ffffff !important;
    font-weight: bold;
    border: 1px solid #64748b;
    border-radius: 4px;
}

/* 閲覧専用（DBからの出力用）ラベルのスタイル */
QLabel#label_toknm1, QLabel#label_nouki, QLabel#label_tyuban, QLabel#label_tanname, QLabel#label_dendat {
    background-color: #f1f5f9;
    font-weight: bold;
    border: 1px solid #475569;
    border-radius: 4px;
    padding: 1px;
    color: #334155;
}

/* 入力エリア（QTextEdit / QDateEdit）のスタイル */
QTextEdit, QDateEdit {
    background-color: #ffffff;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    padding: 1px;
    color: #0f172a;
}
QTextEdit:focus, QDateEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #f8fafc;
}

/* テーブル全体のスタイル */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #475569;
    border: 1px solid #475569;
    padding: 1px;
    border-radius: 4px;
}

</string>
